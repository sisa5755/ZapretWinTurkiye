<Window x:Class="ZapretGuiWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zapret Windows Türkiye (C#/WPF) v1.0"
        Width="440" Height="670"
        ResizeMode="CanMinimize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Implicit (no x:Key) styles: apply to every Button / ComboBox in this
             window automatically, using DynamicResource so toggling the theme
             re-colors every control immediately, with no per-control edits. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The default ComboBox chrome (dropdown arrow + open popup list)
             ignores plain Background/Foreground setters - Microsoft's built-in
             template hardcodes those parts to system colors. That's the
             actual cause of "unreadable in dark mode": the box itself looked
             right, but the arrow strip and/or the opened list stayed light.
             This fully custom template colors every part ourselves. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="{DynamicResource ComboForegroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{DynamicResource ComboBackgroundBrush}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ComboBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ComboForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource ComboForegroundBrush}"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource ComboBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220" SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="{DynamicResource ButtonDisabledBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
            <CheckBox x:Name="ChkDarkMode" Content="Karanlık Mod" VerticalContentAlignment="Center"
                      Checked="ChkDarkMode_Toggled" Unchecked="ChkDarkMode_Toggled"/>
        </StackPanel>

        <StackPanel Grid.Row="1">

            <Border Background="{DynamicResource PanelBackgroundBrush}" Height="80" Margin="0,0,0,10" CornerRadius="4">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="LblStatus" Text="SİSTEM HAZIRLANIYOR..." FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource StatusWarningBrush}" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                    <TextBlock x:Name="LblStrategyInfo" Text="Strateji Durumu: Kontrol Ediliyor..." FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" FontFamily="Segoe UI"/>
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Width="380" Margin="0,6,0,0"
                                 Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Button x:Name="BtnRun" Content="ZAPRET'İ BAŞLAT" FontWeight="Bold" FontSize="14" Height="42"
                    Margin="0,0,0,15" IsEnabled="False" Click="BtnRun_Click"/>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Motor:" FontWeight="Bold" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbEngine" Grid.Row="0" Grid.Column="1" Margin="0,4" IsEnabled="False"
                          SelectionChanged="CmbEngine_SelectionChanged" VerticalContentAlignment="Center"/>

                <TextBlock Text="Strateji:" FontWeight="Bold" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbStrategy" Grid.Row="1" Grid.Column="1" Margin="0,4" IsEnabled="False"
                          SelectionChanged="CmbStrategy_SelectionChanged" VerticalContentAlignment="Center"/>

                <TextBlock Text="Filtre:" FontWeight="Bold" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbFilter" Grid.Row="2" Grid.Column="1" Margin="0,4" IsEnabled="False"
                          VerticalContentAlignment="Center"/>
            </Grid>

            <Button x:Name="BtnLanShare" Content="Ağdaki Cihazlarla Paylaş" FontWeight="Bold" Height="36"
                    Margin="0,10,0,6" IsEnabled="False" Click="BtnLanShare_Click"/>
            <Button x:Name="BtnAnalyze" Content="ISS Analizi (Blockcheck) Yap" FontWeight="Bold" Height="36"
                    Margin="0,6" IsEnabled="False" Click="BtnAnalyze_Click"/>
            <Button x:Name="BtnInstallService" Content="Servis Olarak Yükle (Otomatik Başlat)" FontWeight="Bold"
                    Height="36" Margin="0,6" IsEnabled="False" Click="BtnInstallService_Click"/>
            <Button x:Name="BtnDnscrypt" Content="Dnscrypt-proxy servisi kur" FontWeight="Bold" Height="36"
                    Margin="0,6" Click="BtnDnscrypt_Click"/>
            <Button x:Name="BtnRemoveService" Content="Servis ve Kalıntıları Temizle" FontWeight="Bold" Height="36"
                    Margin="0,6" Click="BtnRemoveService_Click"/>

            <TextBlock x:Name="LblFooter" Text="Zapret Multi-Engine (C# WPF) v1.0" Foreground="{DynamicResource FooterTextBrush}"
                       FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</Window>
