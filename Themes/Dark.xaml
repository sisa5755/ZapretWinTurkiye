<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1F24"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2A2C33"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#ECEFF1"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9AA0A6"/>
    <SolidColorBrush x:Key="FooterTextBrush" Color="#6B7280"/>

    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3D45"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#33353D"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#ECEFF1"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#45484F"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3F424B"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#4A4E58"/>
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#26282E"/>
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#8B9098"/>

    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#2A2C33"/>
    <SolidColorBrush x:Key="ComboForegroundBrush" Color="#ECEFF1"/>

    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#ECEFF1"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#F39C12"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#E74C3C"/>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#2ECC71"/>

</ResourceDictionary>
