<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F2F4F7"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666"/>
    <SolidColorBrush x:Key="FooterTextBrush" Color="#BDC3C7"/>

    <SolidColorBrush x:Key="AppBorderBrush" Color="#CBD2D9"/>

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#F5F6F8"/>
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CBD2D9"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E5E8EC"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#D8DCE1"/>
    <SolidColorBrush x:Key="ButtonDisabledBackgroundBrush" Color="#F0F1F3"/>
    <SolidColorBrush x:Key="ButtonDisabledForegroundBrush" Color="#A5ABB2"/>

    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ComboForegroundBrush" Color="#1F2937"/>

    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#2C3E50"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#E67E22"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#C0392B"/>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#27AE60"/>

</ResourceDictionary>
